# Clause Sentinel Backend Environment Variables

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///./clause_sentinel.db

# CORS Configuration (Comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Classification & Review Configuration
# Predictions with confidence below this threshold or with Uncertain regional origin are flagged for manual review
CONFIDENCE_THRESHOLD=0.65
